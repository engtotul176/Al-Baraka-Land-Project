rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /members/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /payments/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /bankDeposits/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /bankWithdrawals/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /expenseEntries/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}
